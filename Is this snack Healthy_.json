              "value": "==🥗 SnackCheck Verdict\n\nProduct: {{ $('Code - Extraction Information').item.json.productName }} by {{ $('Code - Extraction Information').item.json.brand }}\n\n{{ $('Code - Extraction Information').item.json.sugarLevel === 'high' ? '🔴' : '🟢' }} Sugar: {{ $('Code - Extraction Information').item.json.sugar }}g ({{ $('Code - Extraction Information').item.json.sugarLevel }})\n{{ $('Code - Extraction Information').item.json.saltLevel === 'high' ? '🔴' : '🟢' }} Salt: {{ $('Code - Extraction Information').item.json.salt }}g ({{ $('Code - Extraction Information').item.json.saltLevel }})\n{{ $('Code - Extraction Information').item.json.fatLevel === 'high' ? '🔴' : '🟢' }} Fat: {{ $('Code - Extraction Information').item.json.fat }}g ({{ $('Code - Extraction Information').item.json.fatLevel }})\nNutri-Score: {{ $('Code - Extraction Information').item.json.nutriscoreGrade || 'unknown' }}\n\n{{ $json.verdictMessage }}",

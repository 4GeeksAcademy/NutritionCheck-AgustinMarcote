      "id": "2178a499-74d2-4428-a3ec-f30923c2f818",
      "name": "AI Message"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $json.product ?? {};\nconst n = p.nutriments ?? {};\n\nconst sugar = n.sugars_100g ?? null;\nconst salt  = n.salt_100g ?? null;\nconst fat   = n.fat_100g ?? null;\nconst energy = n['energy-kcal_100g'] ?? null;\n\nconst sugarLevel = sugar == null ? null : sugar < 5 ? 'low' : sugar <= 22.5 ? 'medium' : 'high';\nconst saltLevel  = salt == null ? null : salt > 1.5 ? 'high' : 'low';\nconst fatLevel   = fat == null ? null : fat > 17.5 ? 'high' : 'low';\n\nconst concernScore = [sugarLevel, saltLevel, fatLevel]\n  .filter(l => l === 'high').length;\n\nconst trafficLightVerdict =\n  concernScore === 0 ? 'healthy' :\n  concernScore === 1 ? 'moderate' :\n  'unhealthy';\n\nconst grade = p.nutriscore_grade?.toLowerCase() || null;\nconst nutriScoreVerdict =\n  ['a', 'b'].includes(grade) ? 'healthy' :\n  grade === 'c' ? 'moderate' :\n  ['d', 'e'].includes(grade) ? 'unhealthy' :\n  null;\n\nconst rank = { healthy: 0, moderate: 1, unhealthy: 2 };\nconst verdictLevel = nutriScoreVerdict\n  ? (rank[trafficLightVerdict] > rank[nutriScoreVerdict] ? trafficLightVerdict : nutriScoreVerdict)\n  : trafficLightVerdict;\n\nreturn {\n  json: {\n    productName: p.product_name ?? null,\n    brand: p.brands ?? null,\n    sugar, salt, fat, energy,\n    sugarLevel, saltLevel, fatLevel,\n    concernScore,\n    nutriscoreGrade: grade,\n    verdictLevel\n  }\n};"
      },
